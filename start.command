#!/bin/bash
# ============================================================
#  喵喵电梯公寓 —— 一键启动（macOS 双击这个文件就行）
#  会在本机开一个小服务器并自动打开浏览器
# ============================================================
cd "$(dirname "$0")" || exit 1
PORT=8123

echo "喵喵电梯公寓 启动中…  http://127.0.0.1:${PORT}/index.html"
echo "（关掉这个终端窗口就会停止服务器）"

( sleep 1; open "http://127.0.0.1:${PORT}/index.html" ) &
python3 -m http.server "$PORT" --bind 127.0.0.1
